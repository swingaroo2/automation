    {
      "name": "/booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is a JSON array\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an(\"array\");",
              "});",
              "",
              "pm.test(\"Response array is not empty\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.length).to.be.above(0);",
              "});",
              "",
              "pm.test(\"Each booking has a bookingid\", function () {",
              "    const jsonData = pm.response.json();",
              "    jsonData.forEach(function (booking) {",
              "        pm.expect(booking).to.have.property(\"bookingid\");",
              "    });",
              "});",
              "",
              "pm.test(\"Each bookingid is a number\", function () {",
              "    const jsonData = pm.response.json();",
              "    jsonData.forEach(function (booking) {",
              "        pm.expect(booking.bookingid).to.be.a(\"number\");",
              "    });",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
